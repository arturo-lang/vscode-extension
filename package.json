{
  "name": "arturo",
  "displayName": "Arturo",
  "description": "Runtime-assisted language intelligence, syntax highlighting, and tools for Arturo",
  "version": "0.9.4",
  "publisher": "drkameleon",
  "repository": "https://github.com/arturo-lang/vscode-extension",
  "icon": "icons/gray.png",
  "engines": {
    "vscode": "^1.82.0"
  },
  "activationEvents": [
    "onLanguage:art",
    "onCommand:arturo.runtime.repl",
    "onCommand:arturo.runtime.run",
    "onCommand:arturo.runtime.run-current",
    "onCommand:arturo.runtime.bundle",
    "onCommand:arturo.meta.report-issue",
    "onCommand:arturo.meta.open-docs",
    "onCommand:arturo.package.manage",
    "onLanguage:art-test",
    "onLanguage:art-config",
    "onCommand:arturo.runtime.refresh",
    "onCommand:arturo.runtime.cancel"
  ],
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension",
  "contributes": {
    "commands": [
      {
        "command": "arturo.runtime.repl",
        "title": "Arturo: Open REPL"
      },
      {
        "command": "arturo.runtime.run",
        "title": "Arturo: Run File"
      },
      {
        "command": "arturo.runtime.run-current",
        "title": "Arturo: Run Current File",
        "icon": "$(play)"
      },
      {
        "command": "arturo.runtime.bundle",
        "title": "Arturo: Bundle File"
      },
      {
        "command": "arturo.meta.report-issue",
        "title": "Arturo: Report Issue"
      },
      {
        "command": "arturo.meta.open-docs",
        "title": "Arturo: Open Documentation"
      },
      {
        "command": "arturo.package.manage",
        "title": "Arturo: Manage Packages"
      },
      {
        "command": "arturo.runtime.refresh",
        "title": "Arturo: Refresh Runtime Snapshot"
      },
      {
        "command": "arturo.runtime.cancel",
        "title": "Arturo: Cancel Runtime Refresh"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "arturo.runtime.run-current",
          "group": "navigation@0",
          "when": "resourceLangId == art && !isInDiffEditor && !virtualWorkspace"
        }
      ]
    },
    "languages": [
      {
        "id": "art",
        "aliases": [
          "Arturo",
          "art"
        ],
        "extensions": [
          ".art"
        ],
        "configuration": "./grammar/config.json",
        "icon": {
          "light": "./icons/gray.png",
          "dark": "./icons/gray.png"
        }
      },
      {
        "id": "art-test",
        "aliases": [
          "Unitt Arturo Tests",
          "art-test"
        ],
        "extensions": [
          ".test.art",
          ".spec.art"
        ],
        "configuration": "./grammar/config.json",
        "icon": {
          "light": "./icons/purple.png",
          "dark": "./icons/purple.png"
        }
      },
      {
        "id": "art-config",
        "aliases": [
          "Arturo Config",
          "art-config"
        ],
        "filenames": [
          "info.art",
          "config.art"
        ],
        "configuration": "./grammar/config.json",
        "icon": {
          "light": "./icons/purple.png",
          "dark": "./icons/purple.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "art",
        "scopeName": "source.arturo",
        "path": "./grammar/definition.json"
      },
      {
        "language": "art-test",
        "scopeName": "source.arturo",
        "path": "./grammar/definition.json"
      },
      {
        "language": "art-config",
        "scopeName": "source.arturo",
        "path": "./grammar/definition.json"
      }
    ],
    "snippets": [
      {
        "language": "art",
        "path": "./snippets/arithmetic.json"
      },
      {
        "language": "art",
        "path": "./snippets/bitwise.json"
      },
      {
        "language": "art",
        "path": "./snippets/collections.json"
      },
      {
        "language": "art",
        "path": "./snippets/comparison.json"
      },
      {
        "language": "art",
        "path": "./snippets/core.json"
      },
      {
        "language": "art",
        "path": "./snippets/exceptions.json"
      },
      {
        "language": "art",
        "path": "./snippets/io.json"
      },
      {
        "language": "art",
        "path": "./snippets/iterators.json"
      },
      {
        "language": "art",
        "path": "./snippets/logic.json"
      },
      {
        "language": "art",
        "path": "./snippets/numbers.json"
      },
      {
        "language": "art",
        "path": "./snippets/strings.json"
      },
      {
        "language": "art",
        "path": "./snippets/types.json"
      }
    ],
    "configuration": {
      "title": "Arturo",
      "properties": {
        "arturo.runtime.executable": {
          "type": "string",
          "default": "arturo",
          "description": "Path to Arturo 0.10.0. Used only by explicit runtime refresh.",
          "scope": "resource"
        },
        "arturo.runtime.entrypoint": {
          "type": "string",
          "default": "",
          "description": "Saved entrypoint path, absolute or relative to the workspace folder. No entrypoint is inferred.",
          "scope": "resource"
        },
        "arturo.runtime.args": {
          "type": "array",
          "default": [],
          "description": "Arguments passed to the entrypoint without shell interpolation.",
          "scope": "resource",
          "items": {
            "type": "string"
          }
        },
        "arturo.runtime.cwd": {
          "type": "string",
          "default": "",
          "description": "Working directory, absolute or relative to the workspace folder. Defaults to that folder.",
          "scope": "resource"
        },
        "arturo.runtime.timeoutMs": {
          "type": "integer",
          "default": 30000,
          "description": "Maximum runtime execution time in milliseconds.",
          "scope": "resource",
          "minimum": 100,
          "maximum": 3600000
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint -c .eslintrc.js --ext .ts ./src",
    "test": "bun run compile && bun test tests",
    "catalog": "bun run compile && bun scripts/update-catalog.cjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "1.82.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.9.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.12",
    "vscode-uri": "3.1.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Source features work without trust. Runtime execution requires workspace trust.",
      "restrictedConfigurations": [
        "arturo.runtime"
      ]
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "packageManager": "bun@1.3.12"
}
